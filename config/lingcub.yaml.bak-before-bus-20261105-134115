# 主配置：源、频道、判断器、执行器策略、上限。
# 改这里不需要改代码。
# 约定：谁引用插件，那一条配置就是该插件的配置（plugin/enabled 是内核记账字段，不进插件）。

mode: observe            # observe(只记录) | suggest(建议+人工确认) | auto(白名单自动)

log:
  level: info
  file: data/lingcub.log

store:
  path: data/lingcub.db

sources:
  dingtalk-im:
    enabled: true
    plugin: source-dingtalk
    binary: dws
    # 必须带 --flatten，否则拿到的是 transport envelope 而不是业务字段
    args: ['event', 'consume', 'user_im_message_receive', '--flatten', '-f', 'ndjson']
    groupValues: ['2', 'group']
    # 未实测：本机尚未连钉钉。连上后若报「事件缺字段」，按报错里打印的 payload 顶层键改这里
    fields:
      externalId: messageId
      text: text
      channelId: conversationId
      channelType: conversationType
      actorId: senderStaffId
      occurredAt: createAt
      actorName: senderName
      channelName: conversationTitle

  feishu-im:
    enabled: true
    plugin: source-feishu-im
    binary: lark-cli
    args: ['event', 'consume', 'im.message.receive_v1', '--as', 'bot']

  # 卡片按钮回调：与收消息是**两个独立订阅**（im.message.receive_v1 收不到按钮点击）。
  # 实测载荷取自参考项目日志：{type:'card.action.trigger', event_id, operator_id, message_id, chat_id, action_value}
  feishu-card:
    enabled: true
    plugin: source-feishu-card
    binary: lark-cli
    args: ['event', 'consume', 'card.action.trigger', '--as', 'bot']

channels:
  feishu:
    # 预演：只把「会执行的命令行」写进日志，不真的调 CLI。切换前先看一眼发什么。
    dryRun: false
    plugin: channel-feishu
    defaultChatId: ''    # 填 oc_ 开头的 chatId，否则回消息会失败
    binary: lark-cli

classifiers:
  llm:
    plugin: classifier-llm
    prompt: prompts/classify.md
    minConfidence: 0.3   # 低于此值只记录，不产生 Work
    binary: dsh
    args: ['--profile', 'headless', '--json', '-']

executor_policies:
  claude:
    plugin: executor-claude
    allowRoots: ['E:\Develop_E\tt']
    defaultBudgetUsd: 2
    maxTurns: 40
    binary: claude
    # 实测（claude 2.1.317）：logs/stop 只认短 id（--bg 回的那 8 位），不认完整 uuid
    logsArgs: ['logs', '{{sessionId}}']
    stopArgs: ['stop', '{{sessionId}}']
  dsh:
    plugin: executor-dsh
    allowRoots: ['E:\Develop_E']
    binary: dsh

# 自动回复：窗口停下或跑太久时替你说一句（参考项目 auto-reply 插件的判据）
# 默认关着——没人希望机器人在你没配的情况下自己开口。
auto_reply:
  enabled: false
  pollSeconds: 5
  cooldownSeconds: 60      # 同一窗口这个间隔内最多自动回一次，与命中哪条策略无关
  policies: []
  # 例子（抄进 policies 即可）：
  # - reply: '要不要我接着把剩下的改完？'
  #   enabled: true
  #   triggers:
  #     - when: stopped            # 这一轮结束了
  #       afterSeconds: 900        # 安静 15 分钟才判
  #     - when: stopped
  #       match:
  #         - { mode: contains, text: 'API Error' }
  # - reply: '还在跑，别急'
  #   triggers:
  #     - when: busy
  #       busySeconds: 1800

# 过期数据清理：启动一次，之后每小时一次
cleanup:
  enabled: true
  imageTtlDays: 7          # 图片按天目录保留 7 天
  mappingTtlDays: 14       # 「引用这条消息能找回窗口」的映射保留 14 天
  questionTtlHours: 2      # 超时未答的提问记录
  maxLogBytes: 5242880     # 单个日志超过 5MB 只留尾部一半

sessions:
  # judge：群里的新消息照常判断；open：群里的新消息就是「开一个窗口」，正文当话题名。
  # 接飞书当控制台时用 open，否则用 judge。
  newTopicPolicy: judge
  choiceTtlMs: 1800000   # 等人选工作区的有效期（30 分钟）
  pickMax: 20            # 选择工作区时最多列几个（按最近活跃排序）
  resumeMax: 8           # 恢复会话时最多列几个

limits:
  maxConcurrentSessions: 2
  maxSessionMB: 80       # 单会话历史超此体积后强制换新会话

# v2 插件（清单 v2）。先关着：确认钉钉渠道与派工场景后再打开，避免和旧 source 重复消费。
plugins:
  dingtalk:
    plugin: channel-dingtalk
    enabled: false
  # 文档端口：只注册能力，不改消息入口；真实 block_replace 已用测试文档验证（2026-11-04）
  feishu-doc:
    plugin: capability-doc-feishu
    enabled: true

scenarios:
  dev-dispatch:
    plugin: scenario-dev-dispatch
    enabled: false
    project: personal-lingcub
  doc-todos:
    plugin: scenario-doc-todos
    enabled: false
