{
  "name": "@yue/lingcub",
  "version": "0.1.0",
  "description": "Lingcub — 你的 AI 调度台：消息进，任务出，结果回来",
  "type": "module",
  "bin": { "lingcub": "./dist/main.js" },
  "engines": { "node": ">=24" },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "start": "node dist/main.js",
    "dev": "node --experimental-strip-types src/main.ts",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "docs:check": "node scripts/check-docs.mjs"
  },
  "dependencies": { "yaml": "^2.6.1", "zod": "^3.23.8" },
  "devDependencies": { "typescript": "^5.6.3", "@types/node": "^22.10.0" }
}
